{"dashboard": {"title": "Echo 票务平台监控", "uid": "echo-ticketing-monitor", "tags": ["echo", "ticketing", "monitoring"], "timezone": "browser", "schemaVersion": 27, "version": 1, "refresh": "30s", "panels": [{"id": 1, "title": "实时订单量", "type": "stat", "gridPos": {"h": 6, "w": 4, "x": 0, "y": 0}, "targets": [{"expr": "increase(orders_total[1h])", "legendFormat": "订单总数", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 100}, {"color": "red", "value": 500}]}}}}, {"id": 2, "title": "秒杀库存状态", "type": "table", "gridPos": {"h": 8, "w": 12, "x": 4, "y": 0}, "targets": [{"expr": "seckill_stock_remaining", "format": "table", "instant": true, "legendFormat": "{{ticket_id}}", "refId": "A"}], "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true}, "indexByName": {}, "renameByName": {}}}]}, {"id": 3, "title": "API请求速率", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 16, "y": 0}, "targets": [{"expr": "sum(rate(api_requests_total[5m])) by (status)", "legendFormat": "HTTP {{status}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps"}}}, {"id": 4, "title": "登录成功率", "type": "gauge", "gridPos": {"h": 6, "w": 4, "x": 0, "y": 6}, "targets": [{"expr": "(sum(rate(login_attempts_total{result=\"success\"}[5m])) / sum(rate(login_attempts_total[5m]))) * 100", "legendFormat": "成功率", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 80}, {"color": "green", "value": 95}]}}}}, {"id": 5, "标题": "P95响应时间", "type": "gauge", "gridPos": {"h": 6, "w": 4, "x": 4, "y": 6}, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(api_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P95", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s", "max": 10, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 3}]}}}}, {"id": 6, "title": "核销操作统计", "type": "piechart", "gridPos": {"h": 6, "w": 4, "x": 8, "y": 6}, "targets": [{"expr": "sum(increase(verification_operations_total[1h])) by (result)", "legendFormat": "{{result}}", "refId": "A"}]}, {"id": 7, "title": "错误率趋势", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"expr": "(sum(rate(api_requests_total{status=~\"5..\"}[5m])) / sum(rate(api_requests_total[5m]))) * 100", "legendFormat": "错误率 %", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "max": 100}}}, {"id": 8, "title": "热门端点TOP10", "type": "barchart", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14}, "targets": [{"expr": "topk(10, sum(rate(api_requests_total[5m])) by (endpoint))", "legendFormat": "{{endpoint}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps"}}}], "templating": {"list": []}, "time": {"from": "now-1h", "to": "now"}, "annotations": {"list": []}}}
