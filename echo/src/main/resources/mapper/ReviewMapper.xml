<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.echo.mapper.ReviewMapper">

    <resultMap id="ReviewWithUserMap" type="com.echo.entity.Review">
        <id property="id" column="id"/>
        <result property="showId" column="show_id"/>
        <result property="userId" column="user_id"/>
        <result property="orderId" column="order_id"/>
        <result property="score" column="score"/>
        <result property="content" column="content"/>
        <result property="images" column="images"/>
        <result property="status" column="status"/>
        <result property="likeCount" column="like_count"/>
        <result property="isAnonymous" column="is_anonymous"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>

        <!-- 非数据库字段 -->
        <result property="userName" column="user_name"/>
        <result property="userAvatar" column="user_avatar"/>
        <result property="isLiked" column="is_liked"/>
    </resultMap>

    <!-- 查询评测列表（含用户信息） -->
    <select id="selectReviewPageWithUser" resultMap="ReviewWithUserMap">
        SELECT
            r.*,
            CASE WHEN r.is_anonymous = 1 THEN '匿名用户' ELSE u.nick_name END as user_name,
            CASE WHEN r.is_anonymous = 1 THEN NULL ELSE u.icon END as user_avatar
        FROM ${tablePrefix}review r
        LEFT JOIN ${tablePrefix}user u ON r.user_id = u.id
        WHERE r.show_id = #{showId}
          AND (#{showStatus} IS NULL OR r.status = #{showStatus})
        ORDER BY r.create_time DESC
    </select>
</mapper>
