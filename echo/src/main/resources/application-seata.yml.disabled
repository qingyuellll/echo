# ==========================================================
# Seata 分布式事务配置（当前未启用）
# ==========================================================
#
# 当前状态：文件名带 .disabled 后缀，Spring Boot 不加载此文件
#
# 启用条件：
#    - 业务库按领域拆分为多个物理库，或下单链路拆分为独立微服务并要求原子提交
#
# 启用步骤：
#    1. 取消 pom.xml 中 seata-spring-boot-starter 的注释
#    2. 将此文件重命名为 application-seata.yml
#    3. 部署 Seata Server 并确认 TC 可用
#    4. 为需要跨库原子提交的方法添加 @GlobalTransactional
#    5. 压测对比启用前后的 P99 与吞吐
#
# 决策文档：docs/adr/ADR-001-本地事务与分布式事务取舍.md
#
# 配置说明：
seata:
  enabled: true
  application-id: echo-ticketing
  tx-service-group: echo_tx_group
  service:
    vgroup-mapping:
      echo_tx_group: default
    grouplist:
      default: 127.0.0.1:8091

  registry:
    type: file

  config:
    type: file

  client:
    rm:
      report-success-enable: true
      async-commit-buffer-limit: 10000
    tm:
      commit-retry-count: 5
      rollback-retry-count: 5

logging:
  level:
    io.seata: INFO
