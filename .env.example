# 复制成 .env 后按需修改；不建 .env 也能跑（compose 里有默认值）

# ---- 对外端口（已避开本机已在跑的 8081 / 3306 / 6379 / 9876）----
ADMIN_PORT=3001
USER_PORT=3002
BACKEND_PORT=8089

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=123456

# ---- 后端 JVM ----
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC

# ---- 管理员引导通道 ----
# 全新部署或超管密码遗失时，用该令牌调用 POST /admin/init-password 重置密码
# 请求头格式：X-Bootstrap-Token: <值>
# 留空表示关闭该通道；重置完成后建议清空并重启
ADMIN_BOOTSTRAP_TOKEN=
