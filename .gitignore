# ========================================
# Echo演出票务系统 - Git忽略配置
# ========================================

# ===== Maven构建产物 =====
target/
!.mvn/wrapper/maven-wrapper.jar

# ===== Node.js依赖和构建 =====
node_modules/
dist/
build/
*.tsbuildinfo

# ===== IDE配置（避免团队冲突）=====
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
bin/
*.swp
*.swo
*~
.c9/

# ===== 操作系统文件 =====
.DS_Store
Thumbs.db
Desktop.ini

# ===== 日志文件 =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== Spring Boot =====
*.jar
!lib/gradle-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ===== 环境变量（包含敏感信息，绝对不能提交）=====
.env
.env.local
.env.*.local
.env.production
.env.development
.env.test

# ===== 依赖锁定文件冲突预防 =====
# 建议统一使用npm或yarn，不要混用
# yarn.lock  # 如果使用npm，注释掉这行
# package-lock.json  # 如果使用yarn，注释掉这行

# ===== 测试覆盖率报告 =====
coverage/
.nyc_output/
lcov.info

# ===== 临时文件 =====
*.tmp
*.temp
.cache/
.parcel-cache/

# ===== Docker =====
docker-compose.override.yml

# ===== 数据库 =====
*.sql
!**/src/main/resources/**/*.sql
!**/init-super-admin.sql
*.db
*.sqlite
*.sqlite3

# ===== 备份文件 =====
*.bak
*.backup
*.orig

# ===== 敏感信息（额外保护）=====
secrets.yml
credentials.json
*.pem
*.key
!**/ssl/*.pem  # 允许提交SSL证书（如果需要）

# ===== 监控和分析 =====
.heapdump*
jconsole.xml
jvisualvm.xml

# ===== RocketMQ 本地运行产物 =====
rocketmq/broker-console.log
rocketmq/broker-console.err

# ===== 压测产物 =====
jmeter/*.jtl
jmeter/*.log
jmeter/report/
jmeter/bench/
jmeter/tokens.csv
jmeter/tokens1000.csv
jmeter/_jmreport/
_jmeter_gui.log
# 压测数据准备脚本随仓库分发（仅结构操作，无真实数据）
!jmeter/prepare-seckill.sql
!jmeter/cleanup-bench-users.sql

# ===== 容器部署产物 =====
deploy/dump.err
deploy/build-backend.log
# 建表脚本随仓库分发，含业务数据的初始化 dump 留在本地
!deploy/mysql-init/01-schema.sql
# 上传图片属于运行期数据，仓库只保留占位文件
deploy/imgs/*
!deploy/imgs/.gitkeep

# ===== 数据修复产物 =====
# 修复前的表备份与变更日志含真实业务数据，留在本地
deploy/repair/backup/
deploy/repair/repair-log-*.json
deploy/repair/_repair-*.sql

# ===== Redis 数据快照（含 session/token 等运行数据，绝不上传） =====
*.rdb

# ===== 运行期用户上传图片（nginx 静态目录里的新增上传物） =====
nginx-1.18.0/**/ssn/imgs/blogs/

# ===== 本地监控组件（二进制/数据不入库，配置与面板保留） =====
monitor/*.zip
monitor/prometheus-*/
monitor/prometheus-data/
monitor/grafana-dist/
monitor/grafana-data/
monitor/grafana-logs/
monitor/*.log

# ===== 本机 nginx 发行包（含运行期上传的头像/博客配图，属他人数据）=====
nginx-1.18.0/

# ===== 压测账号与登录令牌清单（手机号+密码 / 有效 token）=====
jmeter/users.csv
jmeter/users-bench.csv

# ===== 线程栈等临时诊断输出 =====
probe-stack.txt
*-stack.txt
